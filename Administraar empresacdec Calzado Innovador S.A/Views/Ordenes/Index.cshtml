@model List<Administraar_empresacdec_Calzado_Innovador_S.A_.Models.OrdenProduccion>
@using Administraar_empresacdec_Calzado_Innovador_S.A_.Models.Enums

@{
    ViewData["Title"] = "Órdenes de producción";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Órdenes de producción</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva orden</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>N.º de orden</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Entrega estimada</th>
                <th>Estado</th>
                <th>Avance</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var orden in Model)
            {
                var total = orden.OrdenProcesos.Count;
                var completados = orden.OrdenProcesos.Count(op => op.Completado);
                var porcentaje = total == 0 ? 0 : (int)Math.Round(completados * 100.0 / total);

                <tr>
                    <td>@orden.NumeroOrden</td>
                    <td>@orden.Producto</td>
                    <td>@orden.CantidadAProducir</td>
                    <td>@orden.FechaEntregaEstimada.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            var badgeClass = orden.Estado switch
                            {
                                EstadoOrden.Pendiente => "bg-secondary",
                                EstadoOrden.EnProceso => "bg-warning text-dark",
                                EstadoOrden.Completada => "bg-success",
                                EstadoOrden.Cancelada => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@orden.Estado</span>
                    </td>
                    <td style="min-width: 140px;">
                        <div class="progress" role="progressbar" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @porcentaje%">@porcentaje%</div>
                        </div>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No hay órdenes registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
