@model List<Administraar_empresacdec_Calzado_Innovador_S.A_.Models.ProcesoFabricacion>

@{
    ViewData["Title"] = "Procesos de fabricación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Procesos de fabricación</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo proceso</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Duración estimada (h)</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var proceso in Model)
            {
                <tr>
                    <td>@proceso.Nombre</td>
                    <td>@proceso.Descripcion</td>
                    <td>@proceso.DuracionEstimadaHoras</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@proceso.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@proceso.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay procesos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
