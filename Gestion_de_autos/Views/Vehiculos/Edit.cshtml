@model DatosAuto
@{ ViewData["Title"] = "Editar vehiculo"; }

<h1>Editar vehiculo</h1>

@if (Model.Fotos != null && Model.Fotos.Any())
{
    <h5>Fotos actuales</h5>
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var foto in Model.Fotos)
        {
            <div class="position-relative">
                <img src="@foto.Ruta" style="width:120px;height:90px;object-fit:cover;" class="rounded border" />
                <form asp-action="EliminarFoto" method="post" class="position-absolute top-0 end-0">
                    <input type="hidden" name="fotoId" value="@foto.Id" />
                    <input type="hidden" name="datosAutoId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-danger" title="Eliminar foto" onclick="return confirm('Eliminar esta foto?')">x</button>
                </form>
            </div>
        }
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Vendedor</label>
        <select asp-for="Usuario" class="form-select" asp-items="ViewBag.Usuario"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Modelo" class="form-label"></label>
        <input asp-for="Modelo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CostoCompra" class="form-label"></label>
        <input asp-for="CostoCompra" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PrecioVenta" class="form-label"></label>
        <input asp-for="PrecioVenta" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Danos" class="form-label"></label>
        <input asp-for="Danos" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PiezasFaltantes" class="form-label"></label>
        <input asp-for="PiezasFaltantes" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" class="form-select">
            <option value="disponible">Disponible</option>
            <option value="reservado">Reservado</option>
            <option value="vendido">Vendido</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Agregar mas fotos</label>
        <input type="file" name="fotos" multiple accept="image/*" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
