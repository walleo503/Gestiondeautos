@model IEnumerable<Usuario>
@{ ViewData["Title"] = "Vendedores"; }

<h1>Vendedores</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo vendedor</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th><th>Apellido</th><th>Telefono</th><th>Correo</th><th>DUI</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>
                <td>@item.Dui</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
