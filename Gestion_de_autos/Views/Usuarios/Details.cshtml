@model Usuario
@{ ViewData["Title"] = "Detalle del vendedor"; }

<h1>Detalle del vendedor</h1>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre @Model.Apellido</dd>
    <dt class="col-sm-2">Telefono</dt><dd class="col-sm-10">@Model.Telefono</dd>
    <dt class="col-sm-2">Correo</dt><dd class="col-sm-10">@Model.Correo</dd>
    <dt class="col-sm-2">DUI</dt><dd class="col-sm-10">@Model.Dui</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
