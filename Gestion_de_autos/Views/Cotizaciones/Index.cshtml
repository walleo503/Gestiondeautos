@model IEnumerable<CotizacionReparacion>
@{ ViewData["Title"] = "Cotizaciones de reparacion"; }

<h1>Cotizaciones de reparacion</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva cotizacion</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Vehiculo</th><th>Pieza</th><th>Precio</th><th>Mano de obra</th><th>Total</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Vehiculo?.Marca @item.Vehiculo?.Modelo</td>
                <td>@item.Pieza</td>
                <td>$@item.Precio.ToString("N2")</td>
                <td>$@item.ManoDeObra.ToString("N2")</td>
                <td>$@item.Total.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
