<div>
    <h2></h2>
    <!-- Requiere casteo si accesskey=" tipo complejo en ViewData -->
    <p>Ventas : @ViewBag["Moneda"] @ViewData["TotalVentas"]</p>

    <!-- ViewBag no requiere casteo explicito-->
    <p>Clientes Nuevos : @ViewBag.NuevosClientes</p>
    @if (ViewBag.MetaAlcanzada){
        <span class="badge">¡Meta Cumplida!</span>
    }
</div>